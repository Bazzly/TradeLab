# Copy to .streamlit/secrets.toml for local dev (gitignored).
# On Streamlit Community Cloud, paste the same keys into
# App settings -> Secrets instead of committing this file.

# Neon (Postgres) — free project at neon.tech
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# OANDA practice/demo account (forex data + paper trading)
OANDA_API_KEY = ""
OANDA_ACCOUNT_ID = ""
OANDA_ENVIRONMENT = "practice"

# Stripe (wired up once a paid feature exists to gate — README_forex.md Section 3.4)
STRIPE_SECRET_KEY = ""
STRIPE_PUBLISHABLE_KEY = ""

# Native Streamlit auth (st.login()) — requires an OIDC provider.
# See https://docs.streamlit.io/develop/concepts/connections/authentication
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "change-me-to-a-random-string"

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

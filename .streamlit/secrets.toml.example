# Copy to .streamlit/secrets.toml for local dev (gitignored).
# On Streamlit Community Cloud, paste the same keys into
# App settings -> Secrets instead of committing this file.

# Neon (Postgres) — free project at neon.tech
# DATABASE_URL must be a least-privileged role WITHOUT BYPASSRLS — Neon's
# default owner role has BYPASSRLS, which makes Row-Level Security a no-op
# for it regardless of FORCE ROW LEVEL SECURITY (verified against a live
# database). Run migrations/0002_app_role.sql (as the owner) to create that
# role, then use its connection string here. Keep the owner's connection
# string only as NEON_ADMIN_DATABASE_URL, for running migrations — never at
# app runtime.
DATABASE_URL = "postgresql://tradelab_app:password@host/dbname?sslmode=require"
NEON_ADMIN_DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# OANDA practice/demo account (forex data + paper trading)
OANDA_API_KEY = ""
OANDA_ACCOUNT_ID = ""
OANDA_ENVIRONMENT = "practice"

# The Economic Calendar page needs NO API key by default — it's a static,
# zero-API list (lib/economic_calendar/static.py). FINNHUB_API_KEY and
# FMP_API_KEY below are only useful if you have/want a PAID plan on either;
# both providers' calendar endpoints are confirmed paid-only even with a
# free-tier key (verified live, see README_forex.md Section 11).
FINNHUB_API_KEY = ""
FMP_API_KEY = ""

# Google Gemini — free API key at aistudio.google.com/apikey, powers the
# Journal page's AI Trade Review (README_forex.md Section 4.8). Chosen over
# Claude/OpenAI specifically because it has a genuinely free ongoing tier,
# not just trial credits (see README_forex.md Section 11).
GEMINI_API_KEY = ""

# Stripe (wired up once a paid feature exists to gate — README_forex.md Section 3.4)
STRIPE_SECRET_KEY = ""
STRIPE_PUBLISHABLE_KEY = ""

# Native Streamlit auth (st.login()) — requires an OIDC provider.
# See https://docs.streamlit.io/develop/concepts/connections/authentication
# Use the localhost value for local dev; switch to the deployed URL below
# when pasting secrets into the Streamlit Community Cloud app settings.
[auth]
# redirect_uri = "http://localhost:8501/oauth2callback"  # local dev
redirect_uri = "https://tradelab.streamlit.app/oauth2callback"  # deployed
cookie_secret = "change-me-to-a-random-string"

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
